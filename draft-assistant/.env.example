# ---------------------------------------------------------------------------
# a2o Draft Assistant — environment variables
# Copy to .env.local (gitignored). Never commit real values.
# ---------------------------------------------------------------------------

# Postgres connection string used by Prisma (app + CLI).
# Local dev:   postgresql://postgres@localhost:5432/a2o_draft
# Supabase:    use the *session pooler* URL for DATABASE_URL and the direct URL for DIRECT_URL
# Neon:        the pooled URL for DATABASE_URL, unpooled for DIRECT_URL
DATABASE_URL="postgresql://postgres@localhost:5432/a2o_draft"
# Optional. Direct (non-pooled) URL for migrations on Supabase/Neon. Falls back to DATABASE_URL.
DIRECT_URL=""
# Database used by `npm test` (tests hit a real Postgres, never a mock).
TEST_DATABASE_URL="postgresql://postgres@localhost:5432/a2o_draft_test"

# Clerk (https://dashboard.clerk.com). Leave both unset in dev to use Clerk keyless mode,
# which provisions a temporary dev instance automatically. Required in production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"

# Authorization allowlist: comma-separated emails permitted to use the app.
# Authentication (Clerk) is not enough — a signed-in user must also be listed here
# (or already exist in the app_users table). The first listed address is the test user.
ALLOWED_EMAILS="test.user@a2oarchitecture.example"

# Anthropic API key. Server-side only; never exposed to the client.
ANTHROPIC_API_KEY=""

# Model tiers. STANDARD handles routine generations; PREMIUM handles hard ones
# (long briefs, historic/HARC/flood-zone work, spec sections by default).
MODEL_STANDARD="claude-sonnet-5-5"
MODEL_PREMIUM="claude-opus-5-5"
# Optional per-type pins. If set, that type always uses this model regardless of difficulty.
MODEL_GENERAL_NOTES=""
MODEL_SPEC_SECTION=""
MODEL_SCHEDULE=""
# Thinking effort passed to the model: low | medium | high
LLM_EFFORT="medium"
# How many grounding examples to put in the prompt per generation.
GROUNDING_EXAMPLE_COUNT="3"

# Rate limit for POST /api/generate, per user.
RATE_LIMIT_GENERATE_MAX="30"
RATE_LIMIT_GENERATE_WINDOW_SECONDS="3600"
